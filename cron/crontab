# swu.guru scrapers — all output goes to stdout (captured by Docker logs)

# Premier: on the hour, Fri noon through Mon noon (tournament weekend window)
0 12-23 * * 5 python -m scraper.melee --cards
0 *     * * 6 python -m scraper.melee --cards
0 *     * * 0 python -m scraper.melee --cards
0 0-12  * * 1 python -m scraper.melee --cards


# Midweek: keep upcoming events fresh
0 2 * * 2-4 python -m scraper.melee --days 90

# HRI: weekly Monday at 1pm (after weekend scraping window closes at noon)
0 13 * * 1 python -m scraper.hri --weekly

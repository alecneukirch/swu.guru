# Stage 1: build React app
FROM node:20-slim AS frontend
WORKDIR /build
COPY frontend2/package.json frontend2/package-lock.json* ./
RUN npm install
COPY frontend2/ ./
RUN npm run build

# Stage 2: Python API
FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
# Copy built frontend into the expected dist location
COPY --from=frontend /build/dist /app/frontend2/dist

ENV PYTHONPATH=/app

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "api2.main:app", "--host", "0.0.0.0", "--port", "8001"]
